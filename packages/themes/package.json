{
  "name": "@moon-inferno/themes",
  "version": "0.3.0",
  "description": "Signature color palettes and CSS variable theme definitions for Moon-Inferno (Inferno, Terminal, Y2K).",
  "license": "MIT",
  "author": "Biagio Scaglia",
  "repository": {
    "type": "git",
    "url": "https://github.com/biagio-scaglia/moon-inferno.git",
    "directory": "packages/themes"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "css-themes",
    "cyberpunk",
    "y2k",
    "terminal",
    "design-tokens",
    "webkit-compatible",
    "moon-inferno"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./moon-inferno.css": "./src/moon-inferno.css",
    "./src/moon-inferno.css": "./src/moon-inferno.css",
    "./terminal.css": "./src/terminal.css",
    "./src/terminal.css": "./src/terminal.css",
    "./y2k.css": "./src/y2k.css",
    "./src/y2k.css": "./src/y2k.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2020",
    "typecheck": "tsc --noEmit"
  }
}
