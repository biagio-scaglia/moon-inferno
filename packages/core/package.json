{
  "name": "@moon-inferno/core",
  "version": "0.4.9",
  "description": "Framework-independent design tokens, CSS variables, responsive primitives, and accessibility utilities for Moon-Inferno.",
  "license": "MIT",
  "author": "Biagio Scaglia",
  "repository": {
    "type": "git",
    "url": "https://github.com/biagio-scaglia/moon-inferno.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "css",
    "design-tokens",
    "accessibility",
    "wcag",
    "retro",
    "cyberpunk",
    "webkit-compatible",
    "moon-inferno"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2020",
    "typecheck": "tsc --noEmit"
  }
}
