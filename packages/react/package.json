{
  "name": "@moon-inferno/react",
  "version": "0.3.2",
  "description": "Accessibility-first, expressive React UI component library for retro, Y2K, CRT, and cyberpunk web applications.",
  "license": "MIT",
  "author": "Biagio Scaglia",
  "repository": {
    "type": "git",
    "url": "https://github.com/biagio-scaglia/moon-inferno.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui-library",
    "components",
    "accessibility",
    "wcag",
    "retro",
    "cyberpunk",
    "pixel-art",
    "webkit-compatible",
    "y2k",
    "moon-inferno"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom,@moon-inferno/themes --target es2020",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@moon-inferno/core": "workspace:*",
    "@moon-inferno/icons": "workspace:*",
    "@moon-inferno/themes": "workspace:*"
  }
}
