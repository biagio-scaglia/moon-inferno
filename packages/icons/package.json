{
  "name": "@moon-inferno/icons",
  "version": "0.1.0",
  "description": "Custom retro SVG iconography system for Moon-Inferno.",
  "license": "MIT",
  "author": "Biagio Scaglia",
  "repository": {
    "type": "git",
    "url": "https://github.com/biagio-scaglia/moon-inferno.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "svg",
    "icons",
    "react-icons",
    "retro-icons",
    "moon-inferno"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
