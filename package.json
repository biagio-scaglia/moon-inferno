{
  "name": "moon-inferno",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @moon-inferno/core build && pnpm --filter @moon-inferno/themes build && pnpm --filter @moon-inferno/icons build && pnpm --filter @moon-inferno/react build && pnpm --filter moon-inferno build && pnpm --filter playground build",
    "typecheck": "pnpm --recursive run typecheck",
    "publish:all": "pnpm publish -r --access public --no-git-checks",
    "bump": "node scripts/bump-version.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
